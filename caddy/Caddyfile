{
    admin off
    auto_https disable_redirects
}

:80 {
    encode gzip zstd
    handle /internal /internal/* {
        respond "Not Found" 404
    }
    import /etc/caddy/conf.d/*.caddy
    handle /guacamole* {
        reverse_proxy guacamole:8080
    }
    handle {
        reverse_proxy panel:5000
    }
}
