# Bastion VPN environment contract.
# Copy to .env and fill values through the approved secret/configuration process.
# Never commit the real .env file.

# Generic host path for the checkout mounted into control-plane containers.
BASTION_PROJECT_ROOT=/opt/bastion-vpn

# External origin used when a public URL is generated automatically.
# Replace outside Git with the deployment's approved origin.
BASTION_PUBLIC_ORIGIN=http://127.0.0.1

# CIDRs that the access containers must route back through their original gateway.
# Supply the real deployment values outside Git.
BASTION_ACCESS_CIDRS=replace-with-deployment-cidrs

# CIDRs forbidden as validation targets. Keep deployment-specific values outside Git.
VALIDATION_DENY_CIDRS=replace-with-deployment-policy

# Immutable image references are supplied by the promotion process.
PANEL_IMAGE=replace-with-immutable-panel-image
MONITOR_IMAGE=replace-with-immutable-monitor-image
CADDY_IMAGE=replace-with-immutable-caddy-image
RECONCILER_IMAGE=replace-with-immutable-reconciler-image
GUACD_IMAGE=replace-with-immutable-guacd-image
GUACAMOLE_IMAGE=replace-with-immutable-guacamole-image

# Shared JSON authentication/signing key for the Guacamole integration.
# Generate with: openssl rand -hex 32
GUAC_JSON_KEY=replace-with-a-secret-generated-outside-git

# External file containing the internal monitor bearer token; never commit the file.
VPN_ENDPOINT_MONITOR_TOKEN_FILE=replace-with-external-token-file

# Promotion gates. Keep all disabled until the canary is approved.
VPN_ENDPOINT_MONITOR_COLLECTION_ENABLED=false
VPN_ENDPOINT_ADMIN_DIAGNOSTICS_ENABLED=false
VPN_ENDPOINT_PUBLIC_ALERTS_ENABLED=false

# Comma-separated numeric VPN IDs for a canary allowlist. An explicit empty
# value probes no targets; omit the variable only for an intentional all-target
# production run.
VPN_ENDPOINT_MONITOR_TARGET_IDS=

# Official monitor defaults; adjust only through the approved deployment process.
VPN_ENDPOINT_MONITOR_INTERVAL=60
VPN_ENDPOINT_MONITOR_FAILURE_THRESHOLD=3
VPN_ENDPOINT_MONITOR_ICMP_COUNT=2
VPN_ENDPOINT_MONITOR_HISTORY_HOURS=5
VPN_ENDPOINT_MONITOR_TIMEOUT=3

# Dedicated endpoint-monitor networks. These defaults are referenced by the
# root-owned nftables policy; change them only in a coordinated firewall release.
VPN_ENDPOINT_MONITOR_EGRESS_SUBNET=172.30.250.0/29
VPN_ENDPOINT_MONITOR_EGRESS_IPV4=172.30.250.2
VPN_ENDPOINT_MONITOR_API_SUBNET=172.30.250.8/29
VPN_ENDPOINT_MONITOR_API_IPV4=172.30.250.10
VPN_ENDPOINT_PANEL_API_IPV4=172.30.250.11
