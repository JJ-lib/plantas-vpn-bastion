# Bastion VPN environment contract.
# Copy to .env and fill values through the approved secret/configuration process.
# Never commit the real .env file.

# Generic host path for the checkout mounted into control-plane containers.
BASTION_PROJECT_ROOT=/opt/bastion-vpn

# External origin used when a public URL is generated automatically.
# Replace outside Git with the deployment's approved origin.
BASTION_PUBLIC_ORIGIN=http://127.0.0.1

# CIDRs that the access containers must route back through their original gateway.
# Supply the real deployment values outside Git.
BASTION_ACCESS_CIDRS=replace-with-deployment-cidrs

# CIDRs forbidden as validation targets. Keep deployment-specific values outside Git.
VALIDATION_DENY_CIDRS=replace-with-deployment-policy

# Immutable image references are supplied by the promotion process.
PANEL_IMAGE=replace-with-immutable-panel-image
RECONCILER_IMAGE=replace-with-immutable-reconciler-image
GUACD_IMAGE=replace-with-immutable-guacd-image
GUACAMOLE_IMAGE=replace-with-immutable-guacamole-image

# Shared JSON authentication/signing key for the Guacamole integration.
# Generate with: openssl rand -hex 32
GUAC_JSON_KEY=replace-with-a-secret-generated-outside-git
