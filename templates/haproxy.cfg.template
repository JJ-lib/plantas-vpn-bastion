global
    log stdout format raw local0
    maxconn 256

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 10s
    timeout client  60s
    timeout server  60s

# Generic example only. Replace TARGET_IP and TARGET_PORT in a deployment-owned copy.
frontend example_http
    bind *:8080
    default_backend example_backend

backend example_backend
    server target 203.0.113.10:443 ssl verify none

# For TCP services, use mode tcp and a deployment-owned target definition.
